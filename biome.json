{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "plugins": [
    "./.biome/rules/no-browser-guards.grit",
    "./.biome/rules/enforce-timer-cleanup.grit",
    "./.biome/rules/enforce-sr-class-prefix.grit",
    "./.biome/rules/no-body-append.grit"
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "a11y": {
        "useFocusableInteractive": "error",
        "useKeyWithClickEvents": "error",
        "useValidAnchor": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.vite",
      "!**/.chrome-profile",
      "!**/site/.docusaurus",
      "!**/site/build",
      "!**/site/docs/api",
      "!**/site/static/assets",
      "!**/site/static/demo",
      "!**/site/static/previews",
      "!**/site/.cache"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/vite-plugin.ts",
        "!src/vite-plugin.js",
        "!src/cli.ts",
        "!src/cli.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/dom/jsx-runtime.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    }
  ]
}
