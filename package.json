{
  "name": "stageroutine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./backgrounds": {
      "types": "./src/dom/backgrounds/index.ts",
      "import": "./src/dom/backgrounds/index.ts"
    },
    "./overlays": {
      "types": "./src/overlays/index.ts",
      "import": "./src/overlays/index.ts"
    },
    "./presenter": {
      "types": "./src/presenter/index.ts",
      "import": "./src/presenter/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/dom/jsx-runtime.ts",
      "import": "./src/dom/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/dom/jsx-dev-runtime.ts",
      "import": "./src/dom/jsx-dev-runtime.ts"
    },
    "./styles.css": "./src/dom/style.css",
    "./style.css": "./src/dom/style.css",
    "./vite": {
      "types": "./src/vite-plugin.ts",
      "import": "./src/vite-plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stageroutine": "./bin/stageroutine"
  },
  "scripts": {
    "dev": "./bin/stageroutine dev",
    "build": "./bin/stageroutine build",
    "verify": "biome check --write . && tsc --noEmit",
    "chrome-dev": "node scripts/chrome-dev.js",
    "api:report": "node scripts/api-report.ts",
    "docs:serve": "pnpm --filter stageroutine-docs start",
    "docs:build": "pnpm --filter stageroutine-docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify/utils": "^3.1.4",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "csstype": "^3.2.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.3",
    "@fontsource/newsreader": "^5.3.0",
    "@iconify/tools": "^5.0.14",
    "marked": "^18.0.11",
    "shiki": "^4.4.3",
    "three": "^0.185.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.2.0"
  }
}
