{
  "name": "stageroutine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/dom/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/dom/jsx-dev-runtime.ts",
    "./styles.css": "./src/dom/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "chrome-dev": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --remote-debugging-port=9222 --user-data-dir=.chrome-profile http://localhost:5173",
    "record": "node --experimental-strip-types scripts/record.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "shiki": "^4.4.3"
  }
}
