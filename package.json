{
  "name": "stageroutine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./backgrounds": {
      "types": "./src/dom/backgrounds/index.ts",
      "import": "./src/dom/backgrounds/index.ts"
    },
    "./overlays": {
      "types": "./src/overlays/index.ts",
      "import": "./src/overlays/index.ts"
    },
    "./presenter": {
      "types": "./src/presenter/index.ts",
      "import": "./src/presenter/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/dom/jsx-runtime.ts",
      "import": "./src/dom/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/dom/jsx-dev-runtime.ts",
      "import": "./src/dom/jsx-dev-runtime.ts"
    },
    "./styles.css": "./src/dom/style.css",
    "./style.css": "./src/dom/style.css",
    "./vite": {
      "types": "./src/vite-plugin.ts",
      "import": "./src/vite-plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "chrome-dev": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --remote-debugging-port=9222 --user-data-dir=.chrome-profile http://localhost:5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "docs:serve": "pnpm --filter stageroutine-docs start",
    "docs:build": "pnpm --filter stageroutine-docs build",
    "docs:version": "pnpm --filter stageroutine-docs docs:version"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify/utils": "^3.1.4",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "csstype": "^3.2.3",
    "typescript": "^5.7.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.3",
    "@fontsource/newsreader": "^5.3.0",
    "marked": "^18.0.11",
    "shiki": "^4.4.3",
    "three": "^0.185.1"
  }
}
