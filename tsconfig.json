{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "stageroutine",
    "paths": {
      "stageroutine": ["./src/index.ts"],
      "stageroutine/backgrounds": ["./src/dom/backgrounds/index.ts"],
      "stageroutine/overlays": ["./src/overlays/index.ts"],
      "stageroutine/presenter": ["./src/presenter/index.ts"],
      "stageroutine/jsx-runtime": ["./src/dom/jsx-runtime.ts"],
      "stageroutine/jsx-dev-runtime": ["./src/dom/jsx-dev-runtime.ts"],
      "stageroutine/styles.css": ["./src/dom/style.css"],
      "stageroutine/style.css": ["./src/dom/style.css"],
      "stageroutine/vite": ["./src/vite-plugin.ts"]
    }
  },
  "include": ["src", "demo", "scripts"]
}
